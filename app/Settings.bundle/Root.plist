<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
        <key>PreferenceSpecifiers</key>
        <array>
                <dict>
                        <key>Type</key>
                        <string>PSGroupSpecifier</string>
                        <key>FooterText</key>
                        <string>Opens the app straight to the settings menu. Useful if you changed anything there and need to change it back but the app won&apos;t start.</string>
                </dict>
                <dict>
                        <key>Type</key>
                        <string>PSToggleSwitchSpecifier</string>
                        <key>Title</key>
                        <string>Recovery Mode</string>
                        <key>Key</key>
                        <string>recovery</string>
                        <key>DefaultValue</key>
                        <false/>
                </dict>
                <dict>
                        <key>Type</key>
                        <string>PSGroupSpecifier</string>
                        <key>FooterText</key>
                        <string>Native JIT translates guest code to native ARM64 instructions. Stock iOS kills any normally-sideloaded app that executes self-generated code, so keep this OFF unless the app was installed via TrollStore.</string>
                </dict>
                <dict>
                        <key>Type</key>
                        <string>PSToggleSwitchSpecifier</string>
                        <key>Title</key>
                        <string>Native JIT</string>
                        <key>Key</key>
                        <string>ish_jit_enabled</string>
                        <key>DefaultValue</key>
                        <false/>
                </dict>
        </array>
</dict>
</plist>
